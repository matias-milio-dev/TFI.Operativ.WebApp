<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Ajustar Server/Database/credenciales al entorno local. Integrated Security
         asume SQL Server con autenticación de Windows (adecuado para entorno académico). -->
    <add name="Operativ"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Operativ;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="TimeoutSesionMinutos" value="20" />
    <!-- Clave maestra AES-256: reemplazar por un valor secreto real fuera de control de versiones en producción. -->
    <add key="ClaveMaestraAes" value="CAMBIAR-ESTA-CLAVE-MAESTRA-EN-PRODUCCION-2026" />
    <add key="RutaXmlGenerado" value="App_Data\XmlGenerado" />
    <!-- SMTP para confirmación de registro y recuperación de contraseña (punto 12 de las mejoras). -->
    <add key="SmtpServidor" value="localhost" />
    <add key="SmtpPuerto" value="25" />
    <add key="SmtpUsuario" value="" />
    <add key="SmtpClave" value="" />
    <add key="SmtpUsarSsl" value="false" />
    <add key="SmtpRemitente" value="no-responder@operativ.local" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240" />

    <globalization culture="auto" uiCulture="auto" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="20" requireSSL="false" slidingExpiration="true" />
    </authentication>

    <!-- sessionState.timeout debe mantenerse alineado con appSettings:TimeoutSesionMinutos -->
    <sessionState mode="InProc" timeout="20" cookieless="false" />

    <!-- requireSSL debe pasar a "true" al desplegar detrás de HTTPS/TLS 1.2 (punto 7/13). -->
    <httpCookies requireSSL="false" httpOnlyCookies="true" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Paginas/ErrorGenerico.aspx" />

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
