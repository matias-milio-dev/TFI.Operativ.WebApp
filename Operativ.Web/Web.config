<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="OperativDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=OperativDb;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="Operativ.Smtp.Servidor" value="smtp.gmail.com" />
    <add key="Operativ.Smtp.Puerto" value="587" />
    <add key="Operativ.Smtp.Usuario" value="gaudiomatias@gmail.com" />
    <add key="Operativ.Smtp.Contrasena" value="punnpyziuaeqgelf" />
    <add key="Operativ.Smtp.UsarSsl" value="true" />
    <add key="Operativ.Smtp.EmailRemitente" value="Operativ &lt;gaudiomatias@gmail.com&gt;" />
    <add key="HabilitarEnvioEmail" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <authentication mode="None" />
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <globalization culture="auto" uiCulture="auto" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
