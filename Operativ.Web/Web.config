<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="OperativDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=OperativDb;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="Operativ.Smtp.Servidor" value="localhost" />
    <add key="Operativ.Smtp.Puerto" value="25" />
    <add key="Operativ.Smtp.Usuario" value="" />
    <add key="Operativ.Smtp.Contrasena" value="" />
    <add key="Operativ.Smtp.UsarSsl" value="false" />
    <add key="Operativ.Smtp.EmailRemitente" value="no-responder@operativ.com" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <authentication mode="None" />
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <globalization culture="auto" uiCulture="auto" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
