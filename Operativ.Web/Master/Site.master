<%@ Master Codebehind="Site.master.cs" Inherits="Operativ.Web.Master.SiteMaster" Language="C#" %>
<%@ Register TagPrefix="uc" TagName="Navbar" Src="~/Controles/Navbar.ascx" %>
<%@ Register TagPrefix="uc" TagName="Footer" Src="~/Controles/Footer.ascx" %>
<%@ Register TagPrefix="uc" TagName="Notificaciones" Src="~/Controles/Notificaciones.ascx" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Operativ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/Site.css" runat="server" />
    <asp:ContentPlaceHolder ID="cphEncabezado" runat="server" />
</head>
<body>
    <form id="frmPrincipal" runat="server">
        <asp:ScriptManager ID="smPrincipal" runat="server" EnablePartialRendering="false" />

        <uc:Navbar ID="ucNavbar" runat="server" />

        <main class="container my-4">
            <uc:Notificaciones ID="ucNotificaciones" runat="server" />
            <asp:ContentPlaceHolder ID="cphContenido" runat="server" />
        </main>

        <uc:Footer ID="ucFooter" runat="server" />
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
